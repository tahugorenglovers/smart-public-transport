# Server Configuration
PORT=3000
JWT_SECRET=super_secret_key_change_this

# Database (used to check the OAuth token blacklist)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=smarttransit
DB_USER=root
DB_PASSWORD=root

# Target Services URL
OAUTH_SERVICE_URL=http://oauth:3002
CITIZEN_SERVICE_URL=http://citizen-service:8000
TRAFFIC_SERVICE_URL=http://traffic-service:8001
# NOTE: index.js reads ENV_SERVICE_URL (not ENVIRONMENT_SERVICE_URL) - both
# are provided in the root .env so whichever name is used resolves correctly.
ENV_SERVICE_URL=http://environment-service:8002
ENVIRONMENT_SERVICE_URL=http://environment-service:8002
PYTHON_ML_URL=http://python-ml:5000

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
