# =====================================================================
# Smart Public Transport Platform - Environment Configuration
#
# Copy this file to `.env` (same folder) and adjust values if needed.
# docker-compose.yml feeds this single file into every container via
# `env_file`, so you only need to maintain ONE file for the whole stack.

# =====================
# Database (MySQL)
# =====================
DB_HOST=mysql
DB_PORT=3306
DB_NAME=smarttransit
DB_USER=root
DB_PASSWORD=root
DB_PASS=root
MYSQL_ROOT_PASSWORD=root

# =====================
# RabbitMQ
# =====================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=/

# =====================
# MQTT
# =====================
MQTT_HOST=mosquitto
MQTT_PORT=1813

# =====================
# JWT / OAuth
# =====================
JWT_SECRET=super_secret_key_change_this
JWT_REFRESH_SECRET=super_secret_refresh_key_change_this

# =====================
# Inter-service URLs (used by express-gateway to proxy requests)
# These point at Docker Compose service names, NOT host ports.
# =====================
OAUTH_SERVICE_URL=http://oauth:3002
CITIZEN_SERVICE_URL=http://citizen-service:8000
TRAFFIC_SERVICE_URL=http://traffic-service:8001
ENVIRONMENT_SERVICE_URL=http://environment-service:8002
ENV_SERVICE_URL=http://environment-service:8002
PYTHON_ML_URL=http://python-ml:5000

# =====================
# App
# =====================
APP_ENV=development
APP_DEBUG=true

# =====================
# Environment-service alert thresholds
# =====================
PASSENGER_OVERCROWDED_THRESHOLD=40
PASSENGER_FULL_THRESHOLD=60
TEMP_HOT_THRESHOLD=30
TEMP_DANGER_THRESHOLD=35
